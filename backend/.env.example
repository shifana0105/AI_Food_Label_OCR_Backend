# Food Label Reader Backend - environment configuration
# Copy this file to .env and adjust values as needed.
# Every value shown here is the default used when the variable is unset.

# Service identity
PROJECT_NAME="Food Label Reader Backend"
VERSION="2.0.0"

# Debug mode (verbose framework errors). Never enable in production.
DEBUG=Talse

# Storage folders (relative paths are resolved against backend/)
UPLOAD_FOLDER=temp
OUTPUT_FOLDER=outputs

# Upload limits
# 15 MB in bytes
MAX_FILE_SIZE=15728640
ALLOWED_EXTENSIONS=jpg,jpeg,png
ALLOWED_MIME_TYPES=image/jpeg,image/png


# OCR engine
OCR_LANGUAGE=en
OCR_USE_ANGLE_CLS=true

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Preprocessing bounds for the longest image side (pixels)
PREPROCESS_MAX_DIMENSION=2000
PREPROCESS_MIN_DIMENSION=600
